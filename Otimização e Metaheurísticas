t(current_mask)\n","            temp_mask[idx] = 1 # Tenta adicionar o item\n","\n","            # Avalia se a máscara temporária é viável\n","            weight, _, viable, _ = evaluate_candidate(temp_mask, df_items, max_capacity)\n","\n","            if viable:\n","                current_mask = temp_mask # Adiciona o item se for viável\n","    return current_mask\n","\n","num_restarts = 20 #num de reinicios aleatorios\n","all_restart_results = []\n","overall_best_solution = None\n","overall_max_value = -1\n","total_objective_evaluations_restarts = 0\n","\n","for restart_id in range(1, num_restarts + 1):\n","    print(f\"Reinício {restart_id}/{num_restarts}...\")\n","    # Gera uma candidata inicial aleatória e viável para este reinício\n","    initial_candidate_restart = generate_initial_candidate_for_restart(df_full, CAPACIDADE_MOCHILA_FULL, seed=restart_id)\n","\n","    # Avalia a candidata inicial gerada (esta contagem é adicionada dentro do hill_climbing)\n","    initial_weight_r, initial_value_r, initial_viable_r, initial_selected_items_r = evaluate_candidate(initial_candidate_restart, df_full, CAPACIDADE_MOCHILA_FULL)\n","\n","    # Executa o Hill Climbing a partir desta candidata inicial\n","    final_solution_r, path_r, num_evaluations_r = hill_climbing(initial_candidate_restart, df_full, CAPACIDADE_MOCHILA_FULL)\n","\n","    total_objective_evaluations_restarts += num_evaluations_r\n","\n","    all_restart_results.append({\n","        'Reinício': restart_id,\n","        'Peso Inicial': initial_weight_r,\n","        'Valor Inicial': initial_value_r,\n","        'Peso Final': final_solution_r['peso_total'],\n","        'Valor Final': final_solution_r['valor_total'],\n","        'Itens Finais': final_solution_r['itens'],\n","        'Máscara Final': final_solution_r['mask'],\n","        'Avaliações': num_evaluations_r\n","    })\n","\n","    if final_solution_r['valor_total'] > overall_max_value:\n","        overall_max_value = final_solution_r['valor_total